include b3_run.py b3_debug.py
include CHANGELOG README.md *.txt
# all of b3/, data files included (plugin sql scripts, sample configs, the bundled GeoIP database...)
recursive-include b3 *
prune b3/docs/user_documentation
recursive-include examples *
recursive-include scripts *
global-exclude *.py[co] __pycache__
exclude .idea/*
prune tests
exclude setup.cfg
